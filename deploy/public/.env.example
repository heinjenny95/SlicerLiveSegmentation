# Public DNS name pointing to this server. Do not include https:// or a path.
LIVESEG_DOMAIN=collaboration.example.org

# Optional address used by the automatic TLS certificate authority.
LIVESEG_EMAIL=admin@example.org

# Generate this value; never commit the real tokens.
LIVESEG_USER_TOKENS_JSON={"replace-with-random-token":"Alice"}

# Maximum decoded live-operation payload (64 MiB by default).
LIVESEG_MAX_UPLOAD_BYTES=67108864

